# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# SageMaker speech endpoints (backend/app/config.py)
REGION=us-east-1
WHISPER_ENDPOINT=whisper-large
# Set after deployment; see docs/stt-models.md.
QWEN_ASR_ENDPOINT=
NEMOTRON_ASR_ENDPOINT=
QWEN_ASR_REGION=ap-northeast-2
NEMOTRON_ASR_REGION=ap-northeast-2
NEMOTRON_STREAMING_ENABLED=false
NEMOTRON_STREAMING_ENDPOINT=
NEMOTRON_STREAMING_REGION=us-east-1
NEMOTRON_STREAMING_CHUNK_MS=560
# Required for local real streaming: use a separate venv for the HTTP/2 SDK's awscrt.
# Docker configures this automatically.
NEMOTRON_STREAM_PYTHON=
QWEN_ASR_INFERENCE_COMPONENT=
NEMOTRON_ASR_INFERENCE_COMPONENT=
# 0 keeps the Qwen/Nemotron copies running; positive seconds enable idle shutdown.
STT_IDLE_SECONDS=0

# Bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# API Gateway WebSocket
NEXT_PUBLIC_WS_ENDPOINT=wss://your-api-gateway-endpoint

# API Gateway REST
NEXT_PUBLIC_API_ENDPOINT=https://your-api-gateway-endpoint

# Cognito (set after CDK deploy)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=us-east-1
